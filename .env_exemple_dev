# 2️⃣ Supprimer l’ancienne instance PM2 si elle existe
pm2 delete ap-palmares

# 3️⃣ Build le projet Next.js
npm run build

# 4️⃣ Lancer Next.js via PM2 avec Node directement
pm2 start node --name "ap-palmares" -- .\node_modules\next\dist\bin\next start 3001

# 5️⃣ Sauvegarder la liste des processus pour auto-start au boot
pm2 save

