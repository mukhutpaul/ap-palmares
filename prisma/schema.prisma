// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===============================
// ENUMS
// ===============================
enum Role {
  ADMIN
  ENSEIGNANT
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  etudiants   Etudiant[]
  classes     Classe[]
  filieres    Filiere[]
  notes       Note[]
  evaluations Evaluation[]
  presences   Presence[]
}

// -------------------------------

model Etudiant {
  id      Int    @id @default(autoincrement())
  nom     String
  postnom String
  prenom  String
  email   String @unique
  sexe    String

  classes     Classe[]
  evaluations Evaluation[]
  notes       Note[]
  presences   Presence[]

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now())
}

// -------------------------------

model Classe {
  id  Int    @id @default(autoincrement())
  nom String

  // Relations optionnelles pour permettre la migration
  filiere   Filiere? @relation(fields: [filiereId], references: [id])
  filiereId Int?

  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id])
  etudiantId Int?

  session   Session? @relation(fields: [sessionId], references: [id])
  sessionId Int?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

// -------------------------------

model Filiere {
  id          Int     @id @default(autoincrement())
  nom         String
  nombreHp    Int     @default(0)
  nombreHt    Int     @default(0)
  description String?

  classes         Classe[]
  notes           Note[]
  evaluations     Evaluation[]
  moduleCotations ModuleCotation[]
  presences       Presence[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

// -------------------------------

model AnneeAcademique {
  id     Int     @id @default(autoincrement())
  annee  String  @unique
  active Boolean @default(false)

  notes       Note[]
  evaluations Evaluation[]
  presences   Presence[]

  createdAt DateTime @default(now())
}

// -------------------------------

model Session {
  id          Int      @id @default(autoincrement())
  designation String
  dateDebut   DateTime
  dateFin     DateTime
  isactive    Boolean  @default(false)

  notes       Note[]
  classes     Classe[]
  evaluations Evaluation[]
  presences   Presence[]

  createdAt DateTime @default(now())
}

// -------------------------------

model Note {
  id            Int    @id @default(autoincrement())
  noteTheorique Float? @default(0)
  notePratique  Float? @default(0)
  noteJyry      Float? @default(0)

  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id])
  etudiantId Int?

  anneeAcademique   AnneeAcademique? @relation(fields: [anneeAcademiqueId], references: [id])
  anneeAcademiqueId Int?

  filiere   Filiere? @relation(fields: [filiereId], references: [id])
  filiereId Int?

  session   Session? @relation(fields: [sessionId], references: [id])
  sessionId Int?

  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

model Evaluation {
  id Int @id @default(autoincrement())

  etudiant   Etudiant @relation(fields: [etudiantId], references: [id])
  etudiantId Int

  filiere   Filiere @relation(fields: [filiereId], references: [id])
  filiereId Int

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId Int

  anneeAcademique   AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])
  anneeAcademiqueId Int

  competences EvaluationCompetence[]

  moyenne Float?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etudiantId, filiereId, sessionId, anneeAcademiqueId])
}

model ModuleCotation {
  id        Int      @id @default(autoincrement())
  intitule  String
  max       Float
  filiere   Filiere  @relation(fields: [filiereId], references: [id])
  filiereId Int
  createdAt DateTime @default(now())

  // Relation correcte vers Competence
  competences Competence[] @relation("ModuleCompetences")
}

model Competence {
  id          Int    @id @default(autoincrement())
  nom         String
  maxScore    Float
  coefficient Float  @default(1)

  // Relation temporairement nullable
  moduleCotation   ModuleCotation? @relation("ModuleCompetences", fields: [moduleCotationId], references: [id])
  moduleCotationId Int? // <- nullable

  evaluations EvaluationCompetence[]
  createdAt   DateTime               @default(now())
}

model EvaluationCompetence {
  id Int @id @default(autoincrement())

  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  evaluationId Int

  competence   Competence @relation(fields: [competenceId], references: [id])
  competenceId Int

  score Float

  @@unique([evaluationId, competenceId])
}

model Presence {
  id Int @id @default(autoincrement())

  etudiant   Etudiant @relation(fields: [etudiantId], references: [id])
  etudiantId Int

  filiere   Filiere @relation(fields: [filiereId], references: [id])
  filiereId Int

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId Int

  anneeAcademique   AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])
  anneeAcademiqueId Int

  status PresenceStatus

  date DateTime @default(now()) // on normalisera à 00:00:00 côté backend

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())

  @@unique([etudiantId, filiereId, sessionId, anneeAcademiqueId, date])
}

enum PresenceStatus {
  PRESENT
  ABSENT
}
