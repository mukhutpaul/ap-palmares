model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  etudiants Etudiant[]
  classes   Classe[]
  filieres  Filiere[]
  notes     Note[]
}

// -------------------------------

model Etudiant {
  id      Int    @id @default(autoincrement())
  nom     String
  postnom String
  prenom  String
  email   String @unique
  sexe    String

  classes Classe[]
  notes   Note[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

// -------------------------------

model Classe {
  id  Int    @id @default(autoincrement())
  nom String

  // Relations optionnelles pour permettre la migration
  filiere   Filiere? @relation(fields: [filiereId], references: [id])
  filiereId Int?

  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id])
  etudiantId Int?

  session   Session? @relation(fields: [sessionId], references: [id])
  sessionId Int?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

// -------------------------------

model Filiere {
  id          Int     @id @default(autoincrement())
  nom         String
  nombreHp    Int     @default(0)
  nombreHt    Int     @default(0)
  description String?

  classes Classe[]
  notes   Note[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

// -------------------------------

model AnneeAcademique {
  id     Int     @id @default(autoincrement())
  annee  String  @unique
  active Boolean @default(false)

  notes Note[]

  createdAt DateTime @default(now())
}

// -------------------------------

model Session {
  id          Int      @id @default(autoincrement())
  designation String
  dateDebut   DateTime
  dateFin     DateTime

  notes   Note[]
  classes Classe[]

  createdAt DateTime @default(now())
}

// -------------------------------

model Note {
  id      Int    @id @default(autoincrement())
  matiere String
  note    Float

  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id])
  etudiantId Int?

  anneeAcademique   AnneeAcademique? @relation(fields: [anneeAcademiqueId], references: [id])
  anneeAcademiqueId Int?

  filiere   Filiere? @relation(fields: [filiereId], references: [id])
  filiereId Int?

  session   Session? @relation(fields: [sessionId], references: [id])
  sessionId Int?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}
