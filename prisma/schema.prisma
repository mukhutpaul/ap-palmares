generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===============================
// ENUMS
// ===============================
enum Role {
  ADMIN
  ENSEIGNANT
  USER
}

enum PresenceStatus {
  PRESENT
  ABSENT
}

// ===============================
// MODELS
// ===============================
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  classes     Classe[]
  filieres    Filiere[]
  notes       Note[]
  evaluations Evaluation[]
  evaluationTheorie EvaluationTheorie[]
}

model Etudiant {
  id          Int      @id @default(autoincrement())

  matricule   String
  nom         String
  postnom     String
  prenom      String
  email       String?
  sexe        String

  telephone   String?
  adresse     String?
  nationalite String?
  avatar      String?

  filiere     String
  session     String?
  vacation    String?

  classes     Classe[]
  evaluations Evaluation[]
  notes       Note[]
  evaluationTheorie EvaluationTheorie[]

  createdAt DateTime @default(now())

  @@unique([matricule, nom, postnom, prenom, email, filiere])
}

model Classe {
  id  Int    @id @default(autoincrement())
  nom String

  filiere   Filiere? @relation(fields: [filiereId], references: [id])
  filiereId Int?

  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id])
  etudiantId Int?

  session   Session? @relation(fields: [sessionId], references: [id])
  sessionId Int?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

model Filiere {
  id          Int     @id @default(autoincrement())
  nom         String
  nombreHp    Int     @default(0)
  nombreHt    Int     @default(0)
  description String?

  classes         Classe[]
  notes           Note[]
  moduleCotations ModuleCotation[]
  evaluationTheorie EvaluationTheorie[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

model AnneeAcademique {
  id     Int     @id @default(autoincrement())
  annee  String  @unique
  active Boolean @default(false)

  notes       Note[]
  evaluationTheorie EvaluationTheorie[]


  createdAt DateTime @default(now())
}

model Session {
  id          Int      @id @default(autoincrement())
  designation String
  dateDebut   DateTime
  dateFin     DateTime
  isactive    Boolean  @default(false)

  notes       Note[]
  classes     Classe[]
  evaluationTheorie EvaluationTheorie[]

  createdAt DateTime @default(now())
}

model Note {
  id            Int    @id @default(autoincrement())
  noteTheorique Float? @default(0)
  notePratique  Float? @default(0)
  noteJyry      Float? @default(0)

  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id])
  etudiantId Int?

  anneeAcademique   AnneeAcademique? @relation(fields: [anneeAcademiqueId], references: [id])
  anneeAcademiqueId Int?

  filiere   Filiere? @relation(fields: [filiereId], references: [id])
  filiereId Int?

  session   Session? @relation(fields: [sessionId], references: [id])
  sessionId Int?

  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

// -------------------------------
// EVALUATION
// -------------------------------
model Evaluation {
  id Int @id @default(autoincrement())

  etudiant   Etudiant @relation(fields: [etudiantId], references: [id])
  etudiantId Int

  module   ModuleCotation? @relation(fields: [moduleId], references: [id])
  moduleId Int?

  competences EvaluationCompetence[]

  moyenne Float?

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etudiantId, moduleId])
}

// -------------------------------
// MODULE ET COMPETENCES
// -------------------------------
model ModuleCotation {
  id        Int      @id @default(autoincrement())
  intitule  String
  max       Float
  filiere   Filiere  @relation(fields: [filiereId], references: [id])
  filiereId Int
  createdAt DateTime @default(now())

  competences Competence[] @relation("ModuleCompetences")
  evaluations Evaluation[]
}

model Competence {
  id          Int    @id @default(autoincrement())
  nom         String
  maxScore    Float
  coefficient Float  @default(1)

  moduleCotation   ModuleCotation? @relation("ModuleCompetences", fields: [moduleCotationId], references: [id])
  moduleCotationId Int?

  evaluations EvaluationCompetence[]
  createdAt   DateTime @default(now())
}

model EvaluationCompetence {
  id Int @id @default(autoincrement())

  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  evaluationId Int

  competence   Competence @relation(fields: [competenceId], references: [id])
  competenceId Int

  score Float

  @@unique([evaluationId, competenceId])
}

// -------------------------------
// PRESENCES
// -------------------------------
model Presence {
  id Int @id @default(autoincrement())

  matricule String

  nom String
  postnom String
  prenom String

  filiere String
  session String

  status PresenceStatus

  date DateTime @default(now())

  createdBy String

  createdAt DateTime @default(now())

  @@unique([matricule, filiere, session, date])
}

model EvaluationTheorie {
  id Int @id @default(autoincrement())

  etudiant   Etudiant @relation(fields: [etudiantId], references: [id])
  etudiantId Int

  filiere   Filiere @relation(fields: [filiereId], references: [id])
  filiereId Int

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId Int

  anneeAcademique   AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])
  anneeAcademiqueId Int
  score Float

  date DateTime @default(now())

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())

  @@unique([etudiantId, filiereId, sessionId, anneeAcademiqueId, date])
}